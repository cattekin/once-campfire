#!/usr/bin/env ruby
require File.expand_path("../../config/environment", File.dirname(__FILE__))

class Backup
  class << self
    def create
      Rails.application.config.database_configuration.fetch(Rails.env).each_value do |config|
        snapshot(Rails.root.join(config.fetch("database")))
      end
    end

    private
      def snapshot(path)
        filename = Rails.root.join("storage", "backups").tap(&:mkpath).join(path.basename)
        temporary = "#{filename}.tmp"

        SQLite3::Database.new(path.to_s, readonly: true) do |source|
          SQLite3::Database.new(temporary) { |dest| copy(source, dest, path) }
        end

        File.rename(temporary, filename)
      ensure
        FileUtils.rm_f(temporary) if temporary
      end

      def copy(source, dest, path)
        backup = SQLite3::Backup.new(dest, "main", source, "main")

        unless backup.step(-1) == SQLite3::Constants::ErrorCode::DONE
          raise "Could not complete backup of #{path}"
        end
      ensure
        backup&.finish
      end
  end
end

Backup.create
