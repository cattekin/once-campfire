#!/usr/bin/env ruby
require "erb"
require "fileutils"
require "yaml"

# Run only while Campfire is stopped. Do not boot Rails against the live files
# from the archive: they may have been copied partway through a write.
root = File.expand_path("../..", __dir__)
environment = ENV.fetch("RAILS_ENV", "production")
backups = File.join(root, "storage", "backups")

# Read the same database list prepare-backup snapshots, without booting Rails.
configuration = YAML.load(ERB.new(File.read(File.join(root, "config", "database.yml"))).result, aliases: true)
database_paths = configuration.fetch(environment).transform_values { |config| File.join(root, config.fetch("database")) }

if File.file?(File.join(backups, File.basename(database_paths.fetch("primary"))))
  database_paths.each_value do |database|
    snapshot = File.join(backups, File.basename(database))

    # Older backups contain only the primary snapshot. Drop any auxiliary live
    # files in that case; db:prepare will recreate them on the next boot.
    FileUtils.mkdir_p(File.dirname(database))
    FileUtils.rm_f([ database, "#{database}-wal", "#{database}-shm", "#{database}-journal" ])
    FileUtils.cp(snapshot, database) if File.file?(snapshot)
  end
end
